@model AmzonClone.Web.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

@if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
{
    <div class="container mt-3">
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    </div>
}

<section class="shop-hero fade-in-up">
    <div class="shop-hero-copy">
        <span class="shop-eyebrow">
            <i class="bi bi-stars"></i> YOUR EVERYDAY MARKETPLACE
        </span>

        <h1>Find your next<br /><span>favorite thing.</span></h1>

        <p>
            Explore products for your home, work, and everything in between.
            Great finds are just a few clicks away.
        </p>

        <div class="shop-hero-actions">
            <a href="#featured-products" class="shop-button-primary">
                Explore products <i class="bi bi-arrow-right"></i>
            </a>
            <a href="#shop-categories" class="shop-button-secondary">
                Browse categories
            </a>
        </div>

        <div class="shop-hero-note">
            <i class="bi bi-truck"></i>
            Discover something useful, delightful, or both.
        </div>
    </div>

    <div class="shop-hero-art" aria-hidden="true">
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>
        <div class="hero-bag"><i class="bi bi-bag-heart-fill"></i></div>
        <span class="hero-floating-icon floating-box"><i class="bi bi-box-seam"></i></span>
        <span class="hero-floating-icon floating-star"><i class="bi bi-stars"></i></span>
        <span class="hero-floating-icon floating-heart"><i class="bi bi-heart-fill"></i></span>
        <div class="hero-art-label">A little something<br />for every day</div>
    </div>
</section>

<section class="shop-benefits container" aria-label="Shopping benefits">
    <div><span><i class="bi bi-grid"></i></span><strong>Explore categories</strong><small>Find what you need</small></div>
    <div><span><i class="bi bi-heart"></i></span><strong>Save favorites</strong><small>Keep them close</small></div>
    <div><span><i class="bi bi-box2-heart"></i></span><strong>Easy ordering</strong><small>Checkout with ease</small></div>
</section>

<section class="shop-section container" id="shop-categories">
    <div class="shop-section-heading">
        <div>
            <span class="shop-eyebrow">BROWSE THE STORE</span>
            <h2>Shop by category</h2>
            <p>Start with a category and see where it takes you.</p>
        </div>
        <a href="#featured-products" class="shop-text-link">
            Explore the store <i class="bi bi-arrow-up-right"></i>
        </a>
    </div>

    <div class="shop-category-grid">
        @if (Model?.Categories?.Any() == true)
        {
            foreach (var category in Model.Categories)
            {
                <a class="shop-category-card" asp-controller="Home" asp-action="Index"
                   asp-route-categoryId="@category.Id" asp-fragment="featured-products">
                    <span class="shop-category-icon"><i class="bi bi-grid-1x2"></i></span>
                    <span class="shop-category-name">@category.Name</span>
                    <i class="bi bi-arrow-up-right category-arrow"></i>
                </a>
            }
        }
        else
        {
            <div class="shop-empty-state">
                <i class="bi bi-grid"></i>
                <span>Categories will appear here when available.</span>
            </div>
        }
    </div>
</section>

<section class="shop-section container" id="featured-products">
    <div class="shop-section-heading">
        <div>
            <span class="shop-eyebrow">PICKS FOR YOU</span>
            <h2>@(Model?.SearchTerm is null && Model?.SelectedCategoryId is null ? "Featured products" : "Products")</h2>
            <p>
                @if (!string.IsNullOrWhiteSpace(Model?.SearchTerm))
                {
                    <span>Results for “@Model.SearchTerm”</span>
                }
                else if (Model?.SelectedCategoryId is not null)
                {
                    <span>Showing products from the selected category.</span>
                }
                else
                {
                    <span>A few good finds to get you started.</span>
                }
            </p>
        </div>
                <a asp-controller="Home" asp-action="Index" class="shop-text-link">
                    Clear filters <i class="bi bi-arrow-counterclockwise"></i>
                </a>
    </div>

    <div class="shop-product-grid">
        @if (Model?.FeaturedProducts?.Any() == true)
        {
            var productsToShow = Model.SearchTerm is null && Model.SelectedCategoryId is null
                ? Model.FeaturedProducts.Take(8)
                : Model.FeaturedProducts;
            foreach (var product in productsToShow)
            {
                var hasOffer =
                product.OfferPrice.HasValue &&
                product.Price > product.OfferPrice.Value &&
                product.Price > 0;

                var discount = hasOffer
                ? (int)Math.Round(
                (product.Price - product.OfferPrice!.Value) /
                product.Price * 100)
                : 0;

                <article class="shop-product-card fade-in-up">
                    <div class="shop-product-image">
                        @if (hasOffer)
                        {
                            <span class="shop-discount">Save @discount%</span>
                        }

                        @if (Context.Session.GetString("CustomerAccessToken") is not null)
                        {
                            <span class="shop-wishlist nav-icon-disabled" aria-disabled="true" title="Wishlist is coming soon">
                                <i class="bi bi-heart" aria-hidden="true"></i>
                            </span>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="shop-wishlist" aria-label="Sign in to save favorites">
                                <i class="bi bi-heart"></i>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@Url.Action("ProductImage", "Home", new { fileName = product.ImageUrl.Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries).LastOrDefault() })"
                                 alt="@product.Name"
                                 loading="lazy"
                                 onerror="this.style.display='none'; this.nextElementSibling.hidden=false;" />
                            <span class="shop-product-placeholder" hidden><i class="bi bi-image"></i></span>
                        }
                        else
                        {
                            <span class="shop-product-placeholder">
                                <i class="bi bi-image"></i>
                            </span>
                        }
                    </div>

                    <div class="shop-product-info">
                        <h3>@product.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                        {
                            <span class="shop-product-category">@product.CategoryName</span>
                        }

                        <div class="shop-rating">
                            <i class="bi bi-star-fill"></i>
                            <span>@product.Rating.ToString("0.0")</span>
                            <span class="shop-review-count">(@product.ReviewCount reviews)</span>
                        </div>

                        <div class="shop-product-price">
                            @if (hasOffer)
                            {
                                <strong>₹@product.OfferPrice!.Value.ToString("N0")</strong>
                                <del>₹@product.Price.ToString("N0")</del>
                            }
                            else
                            {
                                <strong>₹@product.Price.ToString("N0")</strong>
                            }
                        </div>
                    </div>

                    <span class="shop-product-link">
                        In your store catalog <i class="bi bi-arrow-right"></i>
                    </span>
                </article>
            }
        }
        else
        {
            <div class="shop-empty-state">
                <i class="bi bi-box-seam"></i>
                <span>@(string.IsNullOrWhiteSpace(Model?.SearchTerm) && Model?.SelectedCategoryId is null ? "Products will appear here when available." : "No products match these filters.")</span>
            </div>
        }
    </div>
</section>
