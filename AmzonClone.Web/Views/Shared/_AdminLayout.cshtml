<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AmazonClone Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-bag-check-fill"></i>
                <span>AmazonClone<small>ADMIN PANEL</small></span>
            </a>

            <nav class="admin-nav">
                <a class="active" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-grid"></i> Overview
                </a>
                <a asp-controller="Admin" asp-action="Products">
                    <i class="bi bi-box-seam"></i> Products
                </a>
                <a href="#"><i class="bi bi-receipt"></i> Orders</a>
                <a href="#"><i class="bi bi-people"></i> Customers</a>
                <a asp-controller="Admin" asp-action="Categories">
                    <i class="bi bi-collection"></i> Categories
                </a>
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <span>Store Management</span>
                <a asp-controller="Home" asp-action="Index">View Storefront</a>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>