<nav class="custom-navbar" aria-label="Main navigation">
    <a asp-controller="Home" asp-action="Index" class="brand-logo">
        Shop<span>Kart</span>
    </a>

    <form asp-controller="Home" asp-action="Index" method="get" class="search-wrapper">
        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   name="search" value="@ViewBag.SearchTerm"
                   aria-label="Search products"
                   placeholder="Search products, brands and more..." />
            <button class="btn-search" type="submit">Search</button>
        </div>
    </form>

    <div class="nav-actions">
        @if (Context.Session.GetString("CustomerAccessToken") is not null)
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-icon" title="Sign out">
                    <i class="bi bi-person-check" aria-hidden="true"></i><span>Sign out</span>
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="nav-icon" title="Account">
                <i class="bi bi-person" aria-hidden="true"></i><span>Sign in</span>
            </a>
        }

        @if (Context.Session.GetString("CustomerAccessToken") is not null)
        {
            <span class="nav-icon nav-icon-disabled" aria-disabled="true" title="Wishlist page is coming soon">
                <i class="bi bi-heart" aria-hidden="true"></i><span>Wishlist</span>
            </span>
            <a asp-controller="Cart" asp-action="Index" class="nav-icon" title="View cart">
                <i class="bi bi-cart3" aria-hidden="true"></i>
                <span>Cart</span>
            </a>
            <a asp-controller="Address"
               asp-action="Index"
               class="nav-icon"
               title="Saved addresses">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                <span>Addresses</span>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="nav-icon" title="Sign in to view wishlist">
                <i class="bi bi-heart" aria-hidden="true"></i><span>Wishlist</span>
            </a>
            <a asp-controller="Account"
               asp-action="Login"
               asp-route-returnUrl="@Url.Action("Index", "Cart")"
               class="nav-icon"
               title="Sign in to view cart">
                <i class="bi bi-cart3" aria-hidden="true"></i>
                <span>Cart</span>
            </a>
        }

        <button class="mobile-menu-btn"
                type="button"
                aria-label="Show product search"
                aria-expanded="false">
            <i class="bi bi-search" aria-hidden="true"></i>
        </button>
    </div>
</nav>
