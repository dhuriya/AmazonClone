<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AmzonClone.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/AmzonClone.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navnar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold">
                    Amazone
                </a>
                <butoon class="navbar-toggler" type="button" data-ds-toggle="collapse"
                 data-bs-target="#mainNavbar" >
                 <span class="navbar-toggle-icon"></span>
             </butoon>
             <div class="collapse navbar-collapse" id="mainNavbar">
                 <!-- Search -->
                 <form class="d-flex mx-lg-4 flex-grow-1" method="get" 
                 asp-controller="Product" asp-action="Index">
                    <input class="form-control" type="search" name="search"
                    placeholder="Search products..."/>
                    <button class="btn btn-warning ms-2">
                        <i class="bi bi-search"></i>
                    </button>
                 </form>
                 <ul class="navbar-nav ms-auto align-items-lg-center">
                     <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                            asp-controller="Product"
                            asp-action="Index">
                            Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                            asp-controller="Cart"
                            asp-action="Index">
                            <i class="bi bi-cart3"></i>
                            Cart
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                            asp-controller="Wishlist"
                            asp-action="Index">
                            <i class="bi bi-heart"></i>
                            Wishlist
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                            asp-controller="Account"
                            asp-action="Login">
                            <i class="bi bi-person"></i>
                            Login
                        </a>
                    </li>
                 </ul>
             </div>
            </div>
        </nav>
    </header>
    <main class="container-fluid px-0">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5>AmazonClone</h5>
                    <p class="text-secondary">
                        Your complete online shopping platform.
                    </p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Quick Links</h5>

                    <ul class="list-unstyled">
                        <li>
                            <a class="text-light text-decoration-none"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a class="text-light text-decoration-none"
                               asp-controller="Product"
                               asp-action="Index">
                                Products
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Customer Service</h5>

                    <ul class="list-unstyled">
                        <li>Contact Us</li>
                        <li>Orders</li>
                        <li>Returns</li>
                        <li>Help Center</li>
                    </ul>
                </div>
            </div>
            <hr />

            <div class="text-center text-secondary">
                © @DateTime.Now.Year AmazonClone. All rights reserved.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
