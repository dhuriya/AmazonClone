<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <section class="footer-brand-column">
                <a asp-controller="Home" asp-action="Index" class="brand-logo">
                    Shop<span>Kart</span>
                </a>

                <p>
                    Your everyday marketplace for useful finds, thoughtful gifts,
                    and everything in between.
                </p>

                <div class="social-icons" aria-label="Social links">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                </div>
            </section>

            <section class="footer-link-column">
                <h2>Shop</h2>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="featured-products">Featured products</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="shop-categories">Categories</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="featured-products">Popular picks</a></li>
                </ul>
            </section>

            <section class="footer-link-column">
                <h2>Help &amp; account</h2>
                <ul>
                    <li><a asp-controller="Account" asp-action="Login">Sign in</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Create account</a></li>
                    <li><a href="mailto:support@shopkart.example">Contact support</a></li>
                </ul>
            </section>

            <section class="footer-newsletter">
                <h2>Stay in the loop</h2>
                <p>Get product updates and occasional special offers.</p>

                <form class="footer-subscribe" action="#" method="get">
                    <label class="visually-hidden" for="footerEmail">
                        Email address
                    </label>
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <input id="footerEmail" disabled
                           type="email"
                           placeholder="Your email address"
                           autocomplete="email" />
                    <button type="button" aria-label="Newsletter signup coming soon" disabled>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>
                <small class="footer-newsletter-note">
                    Newsletter signup will be connected when its API is available.
                </small>
            </section>
        </div>

        <div class="footer-bottom">
            <span>© @DateTime.Now.Year ShopKart</span>
            <span>Made with <i class="bi bi-heart-fill"></i> in India</span>
        </div>
    </div>
</footer>
