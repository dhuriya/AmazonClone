@model List<AmzonClone.Web.Models.Admin.CategoryAdminViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
}

<section class="dashboard-header">
    <div>
        <span class="dashboard-eyebrow">CATALOG MANAGEMENT</span>
        <h1>Categories</h1>
        <p>Create and manage your store categories.</p>
    </div>
</section>

<div class="category-layout">
    <section class="dashboard-panel category-form-panel">
        <div class="panel-heading">
            <div>
                <h2 id="categoryFormTitle">Add category</h2>
                <p>Create a new product category</p>
            </div>
            <span class="category-form-icon"><i class="bi bi-folder-plus"></i></span>
        </div>

        <div id="toastContainer" class="toast-container"></div>
        @if (TempData["CategorySuccess"] is string success)
        {
            <div id="toastMessage" data-type="success" data-message="@success"></div>
        }

        @if (TempData["CategoryError"] is string error)
        {
            <div id="toastMessage" data-type="error" data-message="@error"></div>
        }
        <form id="categoryForm" asp-controller="Admin" asp-action="CreateCategory" method="post" data-get-url="@Url.Action("GetCategory","Admin")">
            <div class="category-field">
                <label for="categoryName">Category name</label>
                <input type="hidden" id="categoryId" name="id" value="" />
                <input id="categoryName" name="Name" type="text" maxlength="100" required placeholder="e.g. Electronics" />
            </div>
            <div class="category-field">
                <label for="categoryDescription">Description</label>
                <textarea id="categoryDescription" name="Description" rows="4" placeholder="Write a short description"></textarea>
            </div>
            <div class="category-field">
                <label for="categoryIsActive">Status</label>
                <select id="categoryIsActive" name="isActive">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <button id="addCategoryButton" class="category-submit" type="submit">
                <i class="bi bi-plus-lg"></i> Add category
            </button>
            <button id="updateCategoryButton" class="category-submit" type="button" hidden>
                <i class="bi bi-check-lg"></i> Update category
            </button>
            <button id="cancelEditButton" class="category-cancel" type="button" hidden>
                Cancel
            </button>
        </form>
    </section>
    <section class="dashboard-panel category-table-panel">
        <div class="panel-heading category-table-heading">
            <div>
                <h2>All categories</h2>
                <p>Search, filter, edit, or remove categories.</p>
            </div>
            <span class="category-count" id="categoryCount">
                @Model.Count categories
            </span>
        </div>
        <div class="category-filters">
            <label class="category-search">
                <i class="bi bi-search"></i>
                <input id="categorySearch" type="search" placeholder="Search categories..." />
            </label>
            <select id="categoryStatusFilter" aria-label="Filter by status">
                <option value="all">All statuses</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
            <select id="categorySort" aria-label="Sort categories">
                <option value="name-asc">Sort: Name (A–Z)</option>
                <option value="name-desc">Sort: Name (Z–A)</option>
                <option value="newest">Sort: Newest</option>
            </select>

            <select aria-label="Sort categories">
                <option value="name">Sort: Name</option>
                <option value="newest">Sort: Newest</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="category-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var category in Model)
                        {
                            <tr data-category-id="@category.Id" data-category-name="@category.Name.ToLowerInvariant()"
                                data-category-description="@(category.Description?.ToLowerInvariant() ?? "")" 
                                data-category-status="@(category.IsActive ? "active" : "inactive")">
                                <td>
                                    <strong>@category.Name</strong>
                                    <small>ID: @category.Id</small>
                                </td>
                                <td>@(category.Description ?? "—")</td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="category-status active-status">Active</span>
                                    }
                                    else
                                    {
                                        <span class="category-status inactive-status">Inactive</span>
                                    }
                                </td>
                                <td class="category-actions" style="display:flex;">
                                    <button type="button" class="edit-button" data-category-id="@category.Id"
                                            aria-label="Edit @category.Name">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-controller="Admin"
                                          asp-action="DeleteCategory"
                                          method="post"
                                          class="delete-category-form">
                                        <input type="hidden" name="id" value="@category.Id" />

                                        <button type="submit" class="delete-button" aria-label="Delete @category.Name" data-category-name="@category.Name" title="Delete category">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                @(ViewBag.ApiError ?? "Koi category nahi mili.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="categoryNoResults" class="category-no-results" hidden>
                <i class="bi bi-search"></i>
                <strong>No categories match your filters</strong>
                <span>Try a different search or filter.</span>
            </div>
        </div>
        <div class="category-pagination">
            <label>
                Rows per page
                <select id="categoryPageSize">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </label>

            <span id="categoryPageInfo"></span>

            <div>
                <button id="categoryPreviousPage" type="button" aria-label="Previous page">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button id="categoryNextPage" type="button" aria-label="Next page">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    <script>
        const categoryForm = document.getElementById("categoryForm");
        const getCategoryUrl = categoryForm.dataset.getUrl;
        const formTitle = document.getElementById("categoryFormTitle");
        const categoryId = document.getElementById("categoryId");
        const categoryName = document.getElementById("categoryName");
        const categoryDescription = document.getElementById("categoryDescription");
        const categoryIsActive = document.getElementById("categoryIsActive");
        const addButton = document.getElementById("addCategoryButton");
        const updateButton = document.getElementById("updateCategoryButton");
        const cancelButton = document.getElementById("cancelEditButton");
        const toastMessage = document.getElementById("toastMessage");

        document.querySelectorAll(".edit-button").forEach(button => {
            button.addEventListener("click", async () => {
                const id = button.dataset.categoryId;

                try {
                    const response = await fetch(
                        `${getCategoryUrl}?id=${encodeURIComponent(id)}`);

                    if (!response.ok) {
                        throw new Error("Category details load nahi hui.");
                    }

                    const category = await response.json();

                    formTitle.textContent = "Edit category";
                    categoryId.value = category.id;
                    categoryName.value = category.name;
                    categoryDescription.value = category.description ?? "";
                    categoryIsActive.value = String(category.isActive);

                    addButton.hidden = true;
                    cancelButton.hidden = false;
                    updateButton.hidden = false;
                    categoryName.focus();
                } catch (error) {
                    alert(error.message);
                }
            });
        });
        updateButton.addEventListener("click", () => {
            categoryForm.action = '@Url.Action("UpdateCategory", "Admin")';
            categoryForm.requestSubmit();
        });
        cancelButton.addEventListener("click", () => {
            categoryForm.reset();
            categoryId.value = "";

            categoryForm.action = '@Url.Action("CreateCategory", "Admin")';

            addButton.hidden = false;
            updateButton.hidden = true;
            cancelButton.hidden = true;

            formTitle.textContent = "Add category";
        });
        if (toastMessage) {
            const toast = document.createElement("div");
            const isSuccess = toastMessage.dataset.type === "success";

            toast.className = `category-toast ${isSuccess ? "toast-success" : "toast-error"}`;
            toast.innerHTML = `
                <i class="bi ${isSuccess ? "bi-check-circle-fill" : "bi-exclamation-circle-fill"}"></i>
                <span>${toastMessage.dataset.message}</span>
                <button type="button" aria-label="Close">&times;</button>
            `;

            document.getElementById("toastContainer").appendChild(toast);

            toast.querySelector("button").addEventListener("click", () => toast.remove());

            window.setTimeout(() => toast.remove(), 4500);
        }
        document.querySelectorAll(".delete-category-form").forEach(form => {
            form.addEventListener("submit", event => {
                const categoryName =
                    form.dataset.categoryName || "this category";

                const confirmed = window.confirm(
                    `Delete "${categoryName}"? This action cannot be undone.`
                );

                if (!confirmed) {
                    event.preventDefault();
                }
            });
        });
        const searchInput = document.getElementById("categorySearch");
        const statusFilter = document.getElementById("categoryStatusFilter");
        const sortSelect = document.getElementById("categorySort");
        const categoryTable = document.querySelector(".category-table");
        const categoryBody = categoryTable?.querySelector("tbody");
        const noResults = document.getElementById("categoryNoResults");
        const categoryCount = document.getElementById("categoryCount");
        const pageSizeSelect = document.getElementById("categoryPageSize");
        const pageInfo = document.getElementById("categoryPageInfo");
        const previousPageButton = document.getElementById("categoryPreviousPage");
        const nextPageButton = document.getElementById("categoryNextPage");

        let currentPage = 1;

        function filterAndSortCategories() {
            if (!categoryBody) return;

            const query = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value;
            const sortBy = sortSelect.value;
            const pageSize = Number(pageSizeSelect.value);

            const rows = Array.from(
                categoryBody.querySelectorAll("tr[data-category-id]")
            );

            const matchingRows = rows.filter(row => {
                const matchesText =
                    row.dataset.categoryName.includes(query) ||
                    row.dataset.categoryDescription.includes(query);

                const matchesStatus =
                    selectedStatus === "all" ||
                    row.dataset.categoryStatus === selectedStatus;

                return matchesText && matchesStatus;
            });

            matchingRows.sort((a, b) => {
                if (sortBy === "name-asc") {
                    return a.dataset.categoryName.localeCompare(b.dataset.categoryName);
                }

                if (sortBy === "name-desc") {
                    return b.dataset.categoryName.localeCompare(a.dataset.categoryName);
                }

                if (sortBy === "newest") {
                    return Number(b.dataset.categoryId) - Number(a.dataset.categoryId);
                }

                return 0;
            });

            const totalPages = Math.ceil(matchingRows.length / pageSize);
            currentPage = Math.min(currentPage, Math.max(totalPages, 1));

            const start = (currentPage - 1) * pageSize;
            const visibleRows = new Set(matchingRows.slice(start, start + pageSize));

            rows.forEach(row => {
                row.hidden = !visibleRows.has(row);
            });

            matchingRows.forEach(row => categoryBody.appendChild(row));

            noResults.hidden = matchingRows.length > 0;
            categoryCount.textContent = `${matchingRows.length} ${
                matchingRows.length === 1 ? "category" : "categories"
            }`;

            pageInfo.textContent = matchingRows.length === 0
                ? "Showing 0 categories"
                : `Showing ${start + 1}–${Math.min(start + pageSize, matchingRows.length)} of ${matchingRows.length}`;

            previousPageButton.disabled = currentPage <= 1;
            nextPageButton.disabled = currentPage >= totalPages;
        }

        searchInput.addEventListener("input", () => {
            currentPage = 1;
            filterAndSortCategories();
        });

        statusFilter.addEventListener("change", () => {
            currentPage = 1;
            filterAndSortCategories();
        });

        sortSelect.addEventListener("change", () => {
            currentPage = 1;
            filterAndSortCategories();
        });

        pageSizeSelect.addEventListener("change", () => {
            currentPage = 1;
            filterAndSortCategories();
        });

        previousPageButton.addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                filterAndSortCategories();
            }
        });

        nextPageButton.addEventListener("click", () => {
            currentPage++;
            filterAndSortCategories();
        });

        filterAndSortCategories();
        searchInput.addEventListener("input", filterAndSortCategories);
        statusFilter.addEventListener("change", filterAndSortCategories);
        sortSelect.addEventListener("change", filterAndSortCategories);
    </script>
}